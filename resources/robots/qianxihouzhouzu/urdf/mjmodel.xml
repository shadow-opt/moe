<mujoco model="QXHZZ_quadruped">
  <compiler angle="radian" meshdir="../meshes/"/>
  <!-- 仿真参数 -->
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" tolerance="1e-10" solver="Newton" jacobian="dense" cone="pyramidal"/>
  <!-- 默认参数？？ -->
  <default>
    <joint limited="true" armature="0.01" damping="0.1" frictionloss="0.01"/>
    <geom contype="0" conaffinity="0" condim="3" friction="1.0 0.005 0.0001" rgba="0.8 0.6 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-48 48"/>
  </default>
<!-- 资产文件 -->
  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="shenzi" file="shenzi.STL"/>
    <mesh name="yq1" file="yq1.STL"/>
    <mesh name="zh2" file="zh2.STL"/>
    <mesh name="zh3" file="zh3.STL"/>
    <mesh name="zq1" file="zq1.STL"/>
    <mesh name="yh2" file="yh2.STL"/>
    <mesh name="yh3" file="yh3.STL"/>
    <mesh name="zh1" file="zh1.STL"/>
    <mesh name="yh1" file="yh1.STL"/>
  </asset>
  
  <worldbody>
    <!-- Ground plane -->
    <!-- <geom name="floor" type="plane" size="10 10 0.05" rgba="0.7 0.7 0.7 1" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/> -->
    
    <!-- Floating base trunk -->
    <body name="trunk" pos="0 0 1.">
      <!-- Free joint for floating base -->
      <joint name="root_joint" type="free"/>
      
      <!-- Trunk geometry -->
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.77647 0.75686 0.73725 1" mesh="base_link"/>
      <geom name="trunk_collision" type="mesh" rgba="0.77647 0.75686 0.73725 1" mesh="base_link" contype="1" conaffinity="1"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="shenzi"/>
      <geom type="mesh" rgba="1 1 1 1" mesh="shenzi" contype="1" conaffinity="1"/>
      
      <!-- IMU site for sensors -->
      <site name="imu_site" pos="0 0 0" size="0.01"/>
      
      <!-- Inertial properties for trunk (adjust mass as needed) -->
      <inertial pos="0 0 0" mass="8.0" diaginertia="0.1 0.1 0.05"/>
      
      <!-- Front Left Leg -->
      <body name="FL_hip" pos="0.22599 0.05 0">
        <inertial pos="-0.040294 -0.0010631 6.4131e-06" quat="0.503168 0.503168 0.496812 0.496812" mass="0.80054" diaginertia="0.000893159 0.000630935 0.000567334"/>
        <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708"/>
        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yq1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="yq1"/>
        <body name="FL_thigh" pos="0 0.088241 0">
          <inertial pos="0.0030535 -0.015391 -0.04077" quat="0.999453 0 -0.0330766 0" mass="1.22" diaginertia="0.00873952 0.00842409 0.00134995"/>
          <joint name="FL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.5708 3.14159"/>
          <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zh2"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="zh2"/>
          <body name="FL_calf" pos="0 0 -0.22023">
            <inertial pos="-0.00793244 -9.51164e-07 -0.134128" quat="0.706936 0.0155267 0.0155267 0.706936" mass="0.59021" diaginertia="0.0048701 0.00483361 7.50726e-05"/>
            <joint name="FL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.70526 -0.523599"/>
            <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zh3"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="zh3"/>
            <!-- Foot contact sphere -->
            <geom name="FL_foot" type="sphere" size="0.02" pos="0 0 -0.22" rgba="0.3 0.3 0.8 1" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>
          </body>
        </body>
      </body>
      
      <!-- Front Right Leg -->
      <body name="FR_hip" pos="0.22599 -0.05 0">
        <inertial pos="-0.040294 0.0010631 6.4131e-06" quat="0.503168 0.503168 0.496812 0.496812" mass="0.80054" diaginertia="0.000893159 0.000630935 0.000567334"/>
        <joint name="FR_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708"/>
        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zq1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="zq1"/>
        <body name="FR_thigh" pos="0 -0.088241 0">
          <inertial pos="0.0030535 0.015391 -0.04077" quat="0.999453 0 -0.0330766 0" mass="1.22" diaginertia="0.00873952 0.00842409 0.00134995"/>
          <joint name="FR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.5708 3.14159"/>
          <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yh2"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="yh2"/>
          <body name="FR_calf" pos="0 0 -0.22023">
            <inertial pos="-0.00793244 9.61495e-07 -0.134128" quat="0.706936 0.0155267 0.0155267 0.706936" mass="0.59021" diaginertia="0.0048701 0.00483361 7.50726e-05"/>
            <joint name="FR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.70526 -0.523599"/>
            <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yh3"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="yh3"/>
            <!-- Foot contact sphere -->
            <geom name="FR_foot" type="sphere" size="0.02" pos="0 0 -0.22" rgba="0.3 0.3 0.8 1" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>
          </body>
        </body>
      </body>
      
      <!-- Rear Left Leg -->
      <body name="RL_hip" pos="-0.22599 0.05 0">
        <inertial pos="0.040294 -0.0010631 6.4131e-06" quat="0.503168 0.503168 0.496812 0.496812" mass="0.80054" diaginertia="0.000893159 0.000630935 0.000567334"/>
        <joint name="RL_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708"/>
        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zh1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="zh1"/>
        <body name="RL_thigh" pos="0 0.088241 0">
          <inertial pos="-0.0030535 -0.015391 -0.04077" quat="0.999453 0 -0.0330766 0" mass="1.22" diaginertia="0.00873952 0.00842409 0.00134995"/>
          <joint name="RL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.5708 3.14159"/>
          <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zh2"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="zh2"/>
          <body name="RL_calf" pos="0 0 -0.22023">
            <inertial pos="0.00793244 -9.61495e-07 -0.134128" quat="0.706757 0.0222331 0.0222331 0.706757" mass="0.59021" diaginertia="0.0048701 0.00484331 6.53701e-05"/>
            <joint name="RL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.70526 -0.523599"/>
            <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="zh3"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="zh3"/>
            <!-- Foot contact sphere -->
            <geom name="RL_foot" type="sphere" size="0.02" pos="0 0 -0.22" rgba="0.3 0.3 0.8 1" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>
          </body>
        </body>
      </body>
      
      <!-- Rear Right Leg -->
      <body name="RR_hip" pos="-0.22599 -0.05 0">
        <inertial pos="0.040294 0.0010631 6.4131e-06" quat="0.503168 0.503168 0.496812 0.496812" mass="0.80054" diaginertia="0.000893159 0.000630935 0.000567334"/>
        <joint name="RR_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.5708 1.5708"/>
        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yh1"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="yh1"/>
        <body name="RR_thigh" pos="0 -0.088241 0">
          <inertial pos="-0.0030535 0.015391 -0.04077" quat="0.999453 0 -0.0330766 0" mass="1.22" diaginertia="0.00873952 0.00842409 0.00134995"/>
          <joint name="RR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.5708 3.14159"/>
          <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yh2"/>
          <geom type="mesh" rgba="1 1 1 1" mesh="yh2"/>
          <body name="RR_calf" pos="0 0 -0.22023">
            <inertial pos="0.00793244 9.51164e-07 -0.134128" quat="0.706757 0.0222331 0.0222331 0.706757" mass="0.59021" diaginertia="0.0048701 0.00484331 6.53701e-05"/>
            <joint name="RR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.70526 -0.523599"/>
            <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="1 1 1 1" mesh="yh3"/>
            <geom type="mesh" rgba="1 1 1 1" mesh="yh3"/>
            <!-- Foot contact sphere -->
            <geom name="RR_foot" type="sphere" size="0.02" pos="0 0 -0.22" rgba="0.3 0.3 0.8 1" contype="1" conaffinity="1" friction="1.5 0.005 0.0001"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  
  <actuator>
    <motor name="FL_hip_motor" joint="FL_hip_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="FL_thigh_motor" joint="FL_thigh_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="FL_calf_motor" joint="FL_calf_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="FR_hip_motor" joint="FR_hip_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="FR_thigh_motor" joint="FR_thigh_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="FR_calf_motor" joint="FR_calf_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RL_hip_motor" joint="RL_hip_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RL_thigh_motor" joint="RL_thigh_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RL_calf_motor" joint="RL_calf_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RR_hip_motor" joint="RR_hip_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RR_thigh_motor" joint="RR_thigh_joint" ctrlrange="-48 48" ctrllimited="true"/>
    <motor name="RR_calf_motor" joint="RR_calf_joint" ctrlrange="-48 48" ctrllimited="true"/>
  </actuator>
  
  <!-- Sensors -->
  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
  </sensor>
</mujoco>