<mujoco model="QXHZZ_description">

  <!-- 编译器设置，路径直接兼容你之前的URDF对应的网格目录 -->
  <compiler angle="radian" meshdir="../meshes/"/>
  <option gravity="0 0 -9.81"/>

  <!-- 默认属性，参考 Go2 的设定，给予电机转子惯量、阻尼及摩擦 -->
  <default>
    <joint damping="0.02" armature="0.01" frictionloss="0.01"/>
    
    <!-- 视觉组：不参与物理碰撞 -->
    <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    
    <!-- 碰撞组：利用网格的凸包进行物理碰撞测试 -->
    <!-- 关键修复：加入 contype="1" conaffinity="0" 禁用机器人自碰撞，但保留与地面的碰撞 -->
    <default class="collision">
        <geom type="mesh" group="3" contype="1" conaffinity="0"/>
    </default>
  </default>

  <!-- 导入网格与材质 -->
  <asset>
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.77647 0.75686 0.73725 1" />
    <material name="orange" rgba="1 0.65 0 1" />
    <material name="red" rgba="1 0 0 1" />

    <mesh file="base_link.STL" />
    <mesh file="shenzi.STL" />
    <mesh file="yq1.STL" />
    <mesh file="zh2.STL" />
    <mesh file="zh3.STL" />
    <mesh file="zq1.STL" />
    <mesh file="yh2.STL" />
    <mesh file="yh3.STL" />
    <mesh file="zh1.STL" />
    <mesh file="yh1.STL" />
  </asset>

  <worldbody>
    <!-- 地面与光照 -->
    <!-- <geom name="floor" type="plane" size="0 0 0.05" rgba="0.8 0.9 0.8 1" condim="3"/> -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- 躯干，初始高度设为 0.45 避免陷入地面 -->
    <body name="trunk" pos="0 0 0.45">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="5.36" fullinertia="0.055862 0.096172757 0.111591548 0 0 0" />

      <!-- IMU 虚拟连杆与质量 -->
      <body name="imu_link" pos="0 0 0">
          <inertial pos="0 0 0" mass="0.001" fullinertia="0.0001 0.0001 0.0001 0 0 0" />
          <geom type="box" size="0.0005 0.0005 0.0005" material="red" class="visual" />
      </body>

      <!-- Base 与 Trunk 身体网格 -->
      <geom mesh="base_link" material="gray" class="visual" />
      <geom mesh="base_link" class="collision" />
      <geom mesh="shenzi" material="white" class="visual" />
      <geom mesh="shenzi" class="collision" />

      <!-- ================= 前左腿 (FL) ================= -->
      <body name="FL_hip" pos="0.22599 0.05 0">
        <inertial pos="-0.040294 -0.0010631 6.4131E-06" mass="0.80054" fullinertia="0.000567387 0.000893106 0.000630935 0.000004141 0 0"/>
        <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.570796 1.570796" actuatorfrcrange="-48 48"/>
        <geom mesh="yq1" material="white" class="visual" />
        <geom mesh="yq1" class="collision" />

        <body name="FL_thigh" pos="0 0.088241 0">
          <inertial pos="0.0030535 -0.015391 -0.04077" mass="1.22" fullinertia="0.008707219 0.008424086 0.001382252 0 0.000487508 0"/>
          <joint name="FL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.570796 3.141593" actuatorfrcrange="-48 48"/>
          <geom mesh="zh2" material="white" class="visual" />
          <geom mesh="zh2" class="collision" />

          <body name="FL_calf" pos="0 0 -0.22023">
            <inertial pos="-0.0088301 -1.0588E-06 -0.12441" mass="0.53021" fullinertia="0.004322324 0.004363782 0.000070443 -0.000000001 -0.000254221 -0.000000004"/>
            <joint name="FL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.705260 -0.523599" actuatorfrcrange="-48 48"/>
            <geom mesh="zh3" material="white" class="visual" />
            <geom mesh="zh3" class="collision" />

            <!-- 足端 Fixed Joint 省略，直接嵌入子实体 -->
            <body name="FL_foot" pos="0 0 -0.229">
              <inertial pos="0 0 0" mass="0.06" fullinertia="0.0000096 0.0000096 0.0000096 0 0 0"/>
              <geom type="sphere" size="0.03" material="orange" class="visual" />
              <!-- 脚尖我们默认赋予与地面碰撞能力 -->
              <geom type="sphere" size="0.03" condim="4" friction="3 0.2 0.2" solref="0.02 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= 前右腿 (FR) ================= -->
      <body name="FR_hip" pos="0.22599 -0.05 0">
        <inertial pos="-0.040294 0.0010631 6.4131E-06" mass="0.80054" fullinertia="0.000567387 0.000893106 0.000630935 0.000004141 0 0"/>
        <joint name="FR_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.570796 1.570796" actuatorfrcrange="-48 48"/>
        <geom mesh="zq1" material="white" class="visual" />
        <geom mesh="zq1" class="collision" />

        <body name="FR_thigh" pos="0 -0.088241 0">
          <inertial pos="0.0030535 0.015391 -0.04077" mass="1.22" fullinertia="0.008707219 0.008424086 0.001382252 0 0.000487508 0"/>
          <joint name="FR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.570796 3.141593" actuatorfrcrange="-48 48"/>
          <geom mesh="yh2" material="white" class="visual" />
          <geom mesh="yh2" class="collision" />

          <body name="FR_calf" pos="0 0 -0.22023">
            <inertial pos="-0.0088301 1.0703E-06 -0.12441" mass="0.53021" fullinertia="0.004322324 0.004363782 0.000070443 -0.000000001 -0.000254221 -0.000000004"/>
            <joint name="FR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.705260 -0.523599" actuatorfrcrange="-48 48"/>
            <geom mesh="yh3" material="white" class="visual" />
            <geom mesh="yh3" class="collision" />

            <body name="FR_foot" pos="0 0 -0.229">
              <inertial pos="0 0 0" mass="0.06" fullinertia="0.0000096 0.0000096 0.0000096 0 0 0"/>
              <geom type="sphere" size="0.03" material="orange" class="visual" />
              <geom type="sphere" size="0.03" condim="4" friction="3 0.2 0.2" solref="0.02 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= 后左腿 (RL) ================= -->
      <body name="RL_hip" pos="-0.22599 0.05 0">
        <inertial pos="0.040294 -0.0010631 6.4131E-06" mass="0.80054" fullinertia="0.000567387 0.000893106 0.000630935 0.000004141 0 0"/>
        <joint name="RL_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.570796 1.570796" actuatorfrcrange="-48 48"/>
        <geom mesh="zh1" material="white" class="visual" />
        <geom mesh="zh1" class="collision" />

        <body name="RL_thigh" pos="0 0.088241 0">
          <inertial pos="-0.0030535 -0.015391 -0.04077" mass="1.22" fullinertia="0.008707219 0.008424086 0.001382252 0 0.000487508 0"/>
          <joint name="RL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.570796 3.141593" actuatorfrcrange="-48 48"/>
          <geom mesh="zh2" material="white" class="visual" />
          <geom mesh="zh2" class="collision" />

          <body name="RL_calf" pos="0 0 -0.22023">
            <inertial pos="0.0088301 -1.0703E-06 -0.12441" mass="0.53021" fullinertia="0.004322324 0.004363782 0.000070443 -0.000000001 -0.000254221 -0.000000004"/>
            <joint name="RL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.705260 -0.523599" actuatorfrcrange="-48 48"/>
            <geom mesh="zh3" material="white" class="visual" />
            <geom mesh="zh3" class="collision" />

            <body name="RL_foot" pos="0 0 -0.229">
              <inertial pos="0 0 0" mass="0.06" fullinertia="0.0000096 0.0000096 0.0000096 0 0 0"/>
              <geom type="sphere" size="0.03" material="orange" class="visual" />
              <geom type="sphere" size="0.03" condim="4" friction="3 0.2 0.2" solref="0.02 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ================= 后右腿 (RR) ================= -->
      <body name="RR_hip" pos="-0.22599 -0.05 0">
        <inertial pos="0.040294 0.0010631 6.4131E-06" mass="0.80054" fullinertia="0.000567387 0.000893106 0.000630935 0.000004141 0 0"/>
        <joint name="RR_hip_joint" pos="0 0 0" axis="1 0 0" range="-1.570796 1.570796" actuatorfrcrange="-48 48"/>
        <geom mesh="yh1" material="white" class="visual" />
        <geom mesh="yh1" class="collision" />

        <body name="RR_thigh" pos="0 -0.088241 0">
          <inertial pos="-0.0030535 0.015391 -0.04077" mass="1.22" fullinertia="0.008707219 0.008424086 0.001382252 0 0.000487508 0"/>
          <joint name="RR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.570796 3.141593" actuatorfrcrange="-48 48"/>
          <geom mesh="yh2" material="white" class="visual" />
          <geom mesh="yh2" class="collision" />

          <body name="RR_calf" pos="0 0 -0.22023">
            <inertial pos="0.0088301 1.0588E-06 -0.12441" mass="0.53021" fullinertia="0.004322324 0.004363782 0.000070443 -0.000000001 -0.000254221 -0.000000004"/>
            <joint name="RR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.705260 -0.523599" actuatorfrcrange="-48 48"/>
            <geom mesh="yh3" material="white" class="visual" />
            <geom mesh="yh3" class="collision" />

            <body name="RR_foot" pos="0 0 -0.229">
              <inertial pos="0 0 0" mass="0.06" fullinertia="0.0000096 0.0000096 0.0000096 0 0 0"/>
              <geom type="sphere" size="0.03" material="orange" class="visual" />
              <geom type="sphere" size="0.03" condim="4" friction="3 0.2 0.2" solref="0.02 1"/>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- 12个驱动电机定义 -->
  <actuator>
    <motor name="FL_hip"   joint="FL_hip_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="FL_thigh" joint="FL_thigh_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="FL_calf"  joint="FL_calf_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="FR_hip"   joint="FR_hip_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="FR_thigh" joint="FR_thigh_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="FR_calf"  joint="FR_calf_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RL_hip"   joint="RL_hip_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RL_thigh" joint="RL_thigh_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RL_calf"  joint="RL_calf_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RR_hip"   joint="RR_hip_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RR_thigh" joint="RR_thigh_joint" ctrllimited="true" ctrlrange="-48 48"/>
    <motor name="RR_calf"  joint="RR_calf_joint" ctrllimited="true" ctrlrange="-48 48"/>
  </actuator>

  <!-- 关键修复：提供初始关键帧，使所有关节都处于合法的角度范围内，避免模拟瞬间爆炸 -->
  <keyframe>
    <!-- 坐标(3)+四元数(4)+四条腿(12个关节): 按照 FL, FR, RL, RR 顺序应用默认关节角 -->
    <key name="stand" qpos="0 0 0.45 1 0 0 0   0.1 0.8 -1.5   -0.1 0.8 -1.5   0.1 1.0 -1.5   -0.1 1.0 -1.5"/>
  </keyframe>

</mujoco>