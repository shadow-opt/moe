<mujoco model="z2 thin wall">
  <include file="z2.xml"/>
  <statistic center="0.8 0 0.35" extent="2.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="135" elevation="-18"/>
  </visual>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.24 0.27 0.29" rgb2="0.12 0.14 0.15" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.15"/>
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="1 0.005 0.0001"/>
    <!-- Front face x=0.425: base starts at x=0, 0.425 m from the wall. -->
    <geom name="thin_wall" type="box" pos="0.45 0 0.15" size="0.025 0.8 0.15"
          friction="1 0.005 0.0001" rgba="0.72 0.32 0.20 1"/>
  </worldbody>
</mujoco>
