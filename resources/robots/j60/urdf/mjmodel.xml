<mujoco model="quadruped_robot">
  <compiler angle="radian" inertiafromgeom="auto"/>
  
  <!-- 优化的仿真参数 -->
  <option timestep="0.005" iterations="50" solver="Newton" tolerance="1e-10"/>
  
  <!-- 默认参数设置 -->
  <default>
    <joint damping="0.1" frictionloss="0.01"/>
    <geom friction="0.8 0.02 0.01" margin="0.001" gap="0.0"/>
    <motor ctrllimited="true" ctrlrange="-33.5 33.5"/>
  </default>
  
  <!-- 资源 -->
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>
  </asset>

  <worldbody>
    <!-- 地面 -->
    <geom name="ground" size="10 10 0.1" type="plane" material="grid"/>
    <light pos="0 0 3" dir="0 0 -1"/>
    
    <!-- 机器人主体 -->
    <body name="base" pos="0 0 0.5">
      <site name="imu_site" pos="0 0 0.05" size="0.01"/>
      <!-- 浮动基座 -->
      <freejoint name="floating_base"/>
      
      <!-- 主体几何形状（MuJoCo将自动计算惯性） -->
      <geom name="trunk" size="0.171 0.1185 0.0435" type="box" rgba="0.8 0.8 0.8 1" mass="3.728"/>
      
      <!-- 前左腿 (FL) -->
      <body name="FL_hip" pos="0.215 0.075 0">
        <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.802851 0.802851" 
               damping="0.1" frictionloss="0.01"/>
        <geom name="FL_hip_geom" size="0.035 0.01" quat="0.707107 0.707107 0 0" type="cylinder" 
              rgba="1 0.423529 0.0392157 1" mass="0.614"/>
        
        <body name="FL_thigh" pos="0 0.09914 0">
          <joint name="FL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.0472 4.18879" 
                 damping="0.15" frictionloss="0.01"/>
          <geom name="FL_thigh_geom1" size="0.1 0.015 0.017" pos="-0.015 0 -0.1" quat="0.670882 0 0.741564 0" 
                type="box" rgba="1 0.423529 0.0392157 1" mass="0.8"/>
          <geom name="FL_thigh_geom2" size="0.041 0.02" pos="0 -0.008 0" quat="0.707107 0.707107 0 0" 
                type="cylinder" rgba="1 0.423529 0.0392157 1" mass="0.257"/>
          
          <body name="FL_calf" pos="0 0 -0.2">
            <joint name="FL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.69653 -0.916298" 
                   damping="0.1" frictionloss="0.01"/>
            <geom name="FL_calf_geom" size="0.1051 0.008 0.008" pos="0 0 -0.1051" quat="0.707107 0 0.707107 0" 
                  type="box" rgba="1 0.423529 0.0392157 1" mass="0.143"/>
            <geom name="FL_foot" size="0.0225" pos="0 0 -0.2102" rgba="1 0.423529 0.0392157 1" 
                  friction="1.2 0.05 0.01" mass="0.01"/>
          </body>
        </body>
      </body>
      
      <!-- 后左腿 (RL) -->
      <body name="RL_hip" pos="-0.215 0.075 0">
        <joint name="RL_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.802851 0.802851" 
               damping="0.1" frictionloss="0.01"/>
        <geom name="RL_hip_geom" size="0.035 0.01" quat="0.707107 0.707107 0 0" type="cylinder" 
              rgba="1 0.423529 0.0392157 1" mass="0.614"/>
        
        <body name="RL_thigh" pos="0 0.09914 0">
          <joint name="RL_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.0472 4.18879" 
                 damping="0.15" frictionloss="0.01"/>
          <geom name="RL_thigh_geom1" size="0.1 0.015 0.017" pos="-0.015 0 -0.1" quat="0.670882 0 0.741564 0" 
                type="box" rgba="1 0.423529 0.0392157 1" mass="0.8"/>
          <geom name="RL_thigh_geom2" size="0.041 0.02" pos="0 -0.008 0" quat="0.707107 0.707107 0 0" 
                type="cylinder" rgba="1 0.423529 0.0392157 1" mass="0.257"/>
          
          <body name="RL_calf" pos="0 0 -0.2">
            <joint name="RL_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.69653 -0.916298" 
                   damping="0.1" frictionloss="0.01"/>
            <geom name="RL_calf_geom" size="0.1051 0.008 0.008" pos="0 0 -0.1051" quat="0.707107 0 0.707107 0" 
                  type="box" rgba="1 0.423529 0.0392157 1" mass="0.143"/>
            <geom name="RL_foot" size="0.0225" pos="0 0 -0.2102" rgba="1 0.423529 0.0392157 1" 
                  friction="1.2 0.05 0.01" mass="0.01"/>
          </body>
        </body>
      </body>
      
      <!-- 前右腿 (FR) -->
      <body name="FR_hip" pos="0.215 -0.075 0">
        <joint name="FR_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.802851 0.802851" 
               damping="0.1" frictionloss="0.01"/>
        <geom name="FR_hip_geom" size="0.035 0.01" quat="0.707107 0.707107 0 0" type="cylinder" 
              rgba="1 0.423529 0.0392157 1" mass="0.614"/>
        
        <body name="FR_thigh" pos="0 -0.09914 0">
          <joint name="FR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.0472 4.18879" 
                 damping="0.15" frictionloss="0.01"/>
          <geom name="FR_thigh_geom1" size="0.1 0.015 0.017" pos="-0.015 0 -0.1" quat="0.670882 0 0.741564 0" 
                type="box" rgba="1 0.423529 0.0392157 1" mass="0.8"/>
          <geom name="FR_thigh_geom2" size="0.041 0.02" pos="0 0.008 0" quat="0.707107 0.707107 0 0" 
                type="cylinder" rgba="1 0.423529 0.0392157 1" mass="0.257"/>
          
          <body name="FR_calf" pos="0 0 -0.2">
            <joint name="FR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.69653 -0.916298" 
                   damping="0.1" frictionloss="0.01"/>
            <geom name="FR_calf_geom" size="0.1051 0.008 0.008" pos="0 0 -0.1051" quat="0.707107 0 0.707107 0" 
                  type="box" rgba="1 0.423529 0.0392157 1" mass="0.143"/>
            <geom name="FR_foot" size="0.0225" pos="0 0 -0.2102" rgba="1 0.423529 0.0392157 1" 
                  friction="1.2 0.05 0.01" mass="0.01"/>
          </body>
        </body>
      </body>
      
      <!-- 后右腿 (RR) -->
      <body name="RR_hip" pos="-0.215 -0.075 0">
        <joint name="RR_hip_joint" pos="0 0 0" axis="1 0 0" range="-0.802851 0.802851" 
               damping="0.1" frictionloss="0.01"/>
        <geom name="RR_hip_geom" size="0.035 0.01" quat="0.707107 0.707107 0 0" type="cylinder" 
              rgba="1 0.423529 0.0392157 1" mass="0.614"/>
        
        <body name="RR_thigh" pos="0 -0.09914 0">
          <joint name="RR_thigh_joint" pos="0 0 0" axis="0 1 0" range="-1.0472 4.18879" 
                 damping="0.15" frictionloss="0.01"/>
          <geom name="RR_thigh_geom1" size="0.1 0.015 0.017" pos="-0.015 0 -0.1" quat="0.670882 0 0.741564 0" 
                type="box" rgba="1 0.423529 0.0392157 1" mass="0.8"/>
          <geom name="RR_thigh_geom2" size="0.041 0.02" pos="0 0.008 0" quat="0.707107 0.707107 0 0" 
                type="cylinder" rgba="1 0.423529 0.0392157 1" mass="0.257"/>
          
          <body name="RR_calf" pos="0 0 -0.2">
            <joint name="RR_calf_joint" pos="0 0 0" axis="0 1 0" range="-2.69653 -0.916298" 
                   damping="0.1" frictionloss="0.01"/>
            <geom name="RR_calf_geom" size="0.1051 0.008 0.008" pos="0 0 -0.1051" quat="0.707107 0 0.707107 0" 
                  type="box" rgba="1 0.423529 0.0392157 1" mass="0.143"/>
            <geom name="RR_foot" size="0.0225" pos="0 0 -0.2102" rgba="1 0.423529 0.0392157 1" 
                  friction="1.2 0.05 0.01" mass="0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- 电机驱动器 -->
  <actuator>
    <!-- 前左腿电机 -->
    <motor name="FL_hip_motor" joint="FL_hip_joint" gear="1"/>
    <motor name="FL_thigh_motor" joint="FL_thigh_joint" gear="1"/>
    <motor name="FL_calf_motor" joint="FL_calf_joint" gear="1"/>
    
    <!-- 后左腿电机 -->
    <motor name="RL_hip_motor" joint="RL_hip_joint" gear="1"/>
    <motor name="RL_thigh_motor" joint="RL_thigh_joint" gear="1"/>
    <motor name="RL_calf_motor" joint="RL_calf_joint" gear="1"/>
    
    <!-- 前右腿电机 -->
    <motor name="FR_hip_motor" joint="FR_hip_joint" gear="1"/>
    <motor name="FR_thigh_motor" joint="FR_thigh_joint" gear="1"/>
    <motor name="FR_calf_motor" joint="FR_calf_joint" gear="1"/>
    
    <!-- 后右腿电机 -->
    <motor name="RR_hip_motor" joint="RR_hip_joint" gear="1"/>
    <motor name="RR_thigh_motor" joint="RR_thigh_joint" gear="1"/>
    <motor name="RR_calf_motor" joint="RR_calf_joint" gear="1"/>
  </actuator>

  <sensor>
    <!-- IMU传感器 - 必须通过site定位 -->
    <!-- 加速度计 - 测量躯干坐标系下的加速度（包含重力） -->
    <accelerometer name="base_accelerometer" site="imu_site"/>
    <!-- 陀螺仪 - 测量躯干坐标系下的角速度 -->
    <gyro name="base_gyro" site="imu_site"/>
    <!-- 躯干线速度传感器 - 用于调试和验证 -->
    <velocimeter name="base_velocimeter" site="imu_site"/>
  </sensor>
</mujoco>